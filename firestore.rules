rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users may only read and write their own profile, summaries, schedules, and care circle.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /summaries/{summaryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /schedules/{scheduleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /careCircle/{memberId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public read-only educational video metadata (optional CMS collection).
    match /videos/{videoId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
